    "hehenu": {
        "original_spelling": null,
        "terminal_type": "ConnectiveHead",
        "definition": null,
        "description": "接続詞(対比)。文頭に置き、`hesa [節] hesi [節]`の形でhesa側・hesi側それぞれの節を取る(順序は自由)。hesa側は成り立たず、hesi側は成り立つ(¬P∧Q。『PではなくQだ』)。"
    },
    "hehezu": {
        "original_spelling": null,
        "terminal_type": "ConnectiveHead",
        "definition": null,
        "description": "接続詞(定義)。文頭に置き、`hesa [節] hesi [節]`の形でhesa側・hesi側それぞれの節を取る(順序は自由)。hesa側とhesi側は同値(P↔Q)。単なる連言(論理式ではP∧Q)とは異なり、辞書の`definition`を計画言語自身で書くための専用接続詞。`ze`(全称量化マーカー)・`za`/`zi`(定義用のスキーマ変数)と組み合わせて使う。"
    },
    "hehitatu": {
        "original_spelling": null,
        "terminal_type": "ConnectiveHead",
        "definition": null,
        "description": "接続詞(時間の前後)。文頭に置き、`hesa [節] hesi [節]`の形でhesa側・hesi側それぞれの節を取る(順序は自由)。hesa側が時間的に前、hesi側が後の出来事で、両方成り立つ(P∧Q)(旧`hehita`/`hehitu`を統合)。"
    },
    "hehiti": {
        "original_spelling": null,
        "terminal_type": "ConnectiveHead",
        "definition": null,
        "description": "接続詞(同時)。文頭に置き、`hesa [節] hesi [節]`の形でhesa側・hesi側それぞれの節を取る(順序は自由)。hesa側とhesi側は同時に成り立つ(P∧Q)。"
    },
    "hehito": {
        "original_spelling": null,
        "terminal_type": "ConnectiveHead",
        "definition": null,
        "description": "接続詞(条件)。文頭に置き、`hesa [節] hesi [節]`の形でhesa側・hesi側それぞれの節を取る(順序は自由)。hesa側が成り立つならhesi側も成り立つ(P→Q)。"
    },
    "hehoma": {
        "original_spelling": null,
        "terminal_type": "ConnectiveHead",
        "definition": null,
        "description": "接続詞(and)。文頭に置き、`hesa [節] hesi [節]`の形でhesa側・hesi側それぞれの節を取る(順序は自由)。hesa側とhesi側が両方成り立つ(P∧Q)。"
    },
    "hehomi": {
        "original_spelling": null,
        "terminal_type": "ConnectiveHead",
        "definition": null,
        "description": "接続詞(or)。文頭に置き、`hesa [節] hesi [節]`の形でhesa側・hesi側それぞれの節を取る(順序は自由)。hesa側とhesi側のどちらかが成り立つ(P∨Q)。"
    },
    "hehomu": {
        "original_spelling": null,
        "terminal_type": "ConnectiveHead",
        "definition": null,
        "description": "接続詞(xor)。文頭に置き、`hesa [節] hesi [節]`の形でhesa側・hesi側それぞれの節を取る(順序は自由)。hesa側とhesi側のどちらか片方だけが成り立つ(P⊕Q)。"
    },
    "henohito": {
        "original_spelling": null,
        "terminal_type": "ConnectiveHead",
        "definition": null,
        "description": "接続詞(反実仮想条件)。文頭に置き、`hesa [節] hesi [節]`の形でhesa側・hesi側それぞれの節を取る(順序は自由)。hesa側が(反実仮想的に)成り立つならhesi側も成り立つ(P→Q)。`hehito`(条件。hesa側の真偽を保留する直説法条件文)とは異なり、hesa側が実際には成り立たない(または成り立たなかった)という前提を伴う反実仮想条件文専用の接続詞。真理条件は`hehito`と同じ実質含意(P→Q)で、法・言説関係の違いは真理条件レベルでは区別しない(他の接続詞群と同様)。それ自体は時制中立で、節内の`hita`(過去)/`hiti`(現在)と組み合わせて過去反実仮想・現在反実仮想を分析的に区別する。"
    },
    "henosuteto": {
        "original_spelling": null,
        "terminal_type": "ConnectiveHead",
        "definition": null,
        "description": "接続詞(結果⇔反対の原因)。文頭に置き、`hesa [節] hesi [節]`の形でhesa側・hesi側それぞれの節を取る(順序は自由)。hesa側とhesi側が両方成り立つことを表す、逆接的な原因を表す接続詞(『Pなのにもかかわらず(反対の原因により)Q』のように読める。旧`henesute`/`henesuto`を統合)。"
    },
    "hesuteto": {
        "original_spelling": null,
        "terminal_type": "ConnectiveHead",
        "definition": null,
        "description": "接続詞(原因⇔結果)。文頭に置き、`hesa [節] hesi [節]`の形でhesa側・hesi側それぞれの節を取る(順序は自由)。hesa側とhesi側が両方成り立つことを表す(『Pだから/なのでQ』のように読める。hesa側が原因、hesi側が結果。旧`hesute`/`hesuto`を統合)。"
    },
